    "eslint": "^9.22.0",
    "git-cz": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "plop": "^4.0.1",
    "prettier": "^3.5.3",
    "release-it": "^18.1.2",
    "taze": "^19.0.2",
    "tsdown": "^0.6.9",
    "typescript": "^5.8.2",
    "vue": "^3.5.13"
